# ---- PostgreSQL ----
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_DB=frauddb
# Port exposé sur la machine hôte (5433 pour éviter un conflit avec une instance locale)
POSTGRES_PORT=5433

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_ALERTS=fraud-alerts

# ---- Producer ----
CSV_PATH=data/raw/paysim.csv
# messages par seconde (0 = aussi vite que possible)
PRODUCER_RATE=50
# nombre max de lignes (0 = tout le CSV)
PRODUCER_LIMIT=0

# ---- API ----
# Port hôte de l'API Spring Boot (conteneur `api`)
API_PORT=8080

# ---- Spark ----
# earliest : rejoue tout le topic au démarrage ; latest : nouveaux messages uniquement
SPARK_STARTING_OFFSETS=earliest
# Seuils des règles de détection
RULE_HIGH_AMOUNT_THRESHOLD=200000
RULE_VELOCITY_WINDOW=5 minutes
RULE_VELOCITY_SLIDE=1 minute
RULE_VELOCITY_WATERMARK=2 minutes
RULE_VELOCITY_MAX_TX=5
RULE_VELOCITY_MAX_AMOUNT=500000

# ---- Machine learning ----
# Version du modèle à charger par le job streaming (vide = celle pointée par models/fraud_gbt/latest)
ML_MODEL_VERSION=
